# Template only: the server never loads this file. Use it for a systemd EnvironmentFile or export the variables.

# HTTP mode port (default 8006). Ignored when --port is passed on the command line.
PORT=8006

# Required for web_search. Brave Search API key (Search plan). Sent only to api.search.brave.com.
BRAVE_API_KEY=

# Optional. Raises the GitHub API rate limit for the fetch tool's GitHub extractor. Sent only to api.github.com, raw.githubusercontent.com, and gist.githubusercontent.com.
GITHUB_TOKEN=
