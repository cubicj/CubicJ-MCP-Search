{
  "name": "cubicj-mcp-search",
  "version": "0.1.0",
  "description": "MCP server with two read-only tools: web_search (Brave LLM Context) and fetch (Defuddle extraction)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cubicj-mcp-search": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.2.0",
    "defuddle": "^0.19.2",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^6.2.108",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
